Object.assign(App, {
    updateToolbar() {
        let node = null;
        // Prioritize focusedNodes (Multi-Focus Mode) or fallback to selection
        if (this.state.focusedNodes.size > 0) {
            const lastId = Array.from(this.state.focusedNodes).pop();
            node = this.nodes.get(lastId);
        } else if (this.selected.size > 0) {
            const lastId = Array.from(this.selected).pop();
            node = this.nodes.get(lastId);
        } else if (this.state.focusedNode) {
            node = this.nodes.get(this.state.focusedNode);
        }

        // HIDE TOOLBAR DURING ACTIVE INTERACTION
        // This ensures it doesn't pop up while dragging, brushing, or panning
        if (this._mode === 'focus-brush' || this._mode === 'focus-mode' ||
            this._mode === 'drag' || this._mode === 'pan' || this._mode === 'resize') {
            this.ui.toolbar.style.display = "none";
            return;
        }

        // Logic to support focusing children while parent is editing
        if (node && node.parent && node.parent.isEditing) {
            // If child is focused in edit mode, toolbar should be relative to the CHILD
            // (Standard behavior should cover this since `node` is the child)

            // Ensure Group Edit button stays active/visible if parent is editing?
            // Actually, if we focus the child, we lose the parent selection.
            // But we can check parent state.
        }

        if (node) {
            const rect = node.element.getBoundingClientRect();
            this.ui.toolbar.style.display = "flex";

            // Calculate position with boundary checking
            const tbWidth = this.ui.toolbar.offsetWidth || 400;
            let left = rect.left + rect.width / 2;
            let top = rect.top - 15;

            // Keep toolbar on screen horizontally
            const margin = 20;
            if (left - tbWidth / 2 < margin) left = tbWidth / 2 + margin;
            if (left + tbWidth / 2 > window.innerWidth - margin) left = window.innerWidth - tbWidth / 2 - margin;

            this.ui.toolbar.style.left = `${left}px`;
            this.ui.toolbar.style.top = `${Math.max(80, top)}px`;
            this.ui.toolbar.style.transform = "translateX(-50%) translateY(-100%)";
            const lockBtn = document.getElementById("lock-btn");
            lockBtn.innerHTML = node.locked ? '<i data-lucide="lock"></i>' : '<i data-lucide="unlock"></i>';
            lockBtn.className = node.locked ? "icon-btn active" : "icon-btn";
            if (typeof lucide !== 'undefined') lucide.createIcons({ root: lockBtn });

            // Buttons visibility
            const isTextOrCode = node.type === 'text' || node.type === 'code' || node.type === 'text-with-title';
            const isFolder = node.type === 'folder';
            const isImage = node.type === "image";
            const isEmpty = node.type === 'empty';
            const isIcon = node.type === 'icon';
            const isContainer = node.type === 'container';
            const isMultiple = this.selected.size > 1 || this.state.focusedNodes.size > 1;

            document.getElementById("btn-edit").style.display = (isTextOrCode && !isMultiple) ? "flex" : "none";
            document.getElementById("btn-rename-folder").style.display = isFolder ? "flex" : "none";
            document.getElementById("btn-change-image").style.display = (isImage || isFolder) ? "flex" : "none";

            // Container Controls
            document.getElementById("btn-layout-vertical").style.display = isContainer ? "flex" : "none";
            document.getElementById("btn-layout-horizontal").style.display = isContainer ? "flex" : "none";

            // No side panel anymore - everything is in toolbar/popups


            // Helper to highlight active layout
            if (isContainer) {
                document.getElementById("btn-layout-vertical").classList.toggle("active", node.layout === 'vertical');
                document.getElementById("btn-layout-horizontal").classList.toggle("active", node.layout === 'horizontal');
            }

            // Empty Node Conversion Buttons
            document.getElementById("btn-convert-text").style.display = isEmpty ? "flex" : "none";
            document.getElementById("btn-convert-image").style.display = isEmpty ? "flex" : "none";
            document.getElementById("btn-convert-icon").style.display = isEmpty ? "flex" : "none";

            // Icon Node Action
            document.getElementById("btn-change-icon").style.display = isIcon ? "flex" : "none";

            // Image Edit (Pen) button logic
            const btnImageEdit = document.getElementById("btn-image-edit");
            if (btnImageEdit) {
                const isImage = node && node.type === 'image';
                const hasMultipleImages = isImage && node.images && node.images.length > 1;
                btnImageEdit.style.display = (isImage && !isMultiple && hasMultipleImages) ? "flex" : "none";

                if (isImage && node.isEditing) {
                    btnImageEdit.classList.add("active");
                } else {
                    btnImageEdit.classList.remove("active");
                }
            }

            // Container Button (Any Node)
            const btnCreateContainer = document.getElementById("btn-create-container");
            if (btnCreateContainer) {
                // Show if multiple nodes are selected/focused, or if a single node is selected/focused
                // and it's not already a container (group)
                const canCreateContainer = (this.selected.size > 1 || this.state.focusedNodes.size > 1) ||
                    (node && node.type !== 'group');
                btnCreateContainer.style.display = canCreateContainer ? "flex" : "none";
            }

            // Container Layout Controls + Settings Button
            const btnLayoutVertical = document.getElementById("btn-layout-vertical");
            const btnLayoutHorizontal = document.getElementById("btn-layout-horizontal");
            const btnLayoutSettings = document.getElementById("btn-layout-settings");
            if (btnLayoutVertical && btnLayoutHorizontal) {
                const showLayoutControls = isContainer && !isMultiple;
                btnLayoutVertical.style.display = showLayoutControls ? "flex" : "none";
                btnLayoutHorizontal.style.display = showLayoutControls ? "flex" : "none";
                if (btnLayoutSettings) {
                    btnLayoutSettings.style.display = showLayoutControls ? "flex" : "none";
                }
            }

            // Save Component Button
            const btnSaveComponent = document.getElementById("btn-save-component");
            if (btnSaveComponent) {
                // Show if we have any selection (Container OR other nodes)
                // If it's a container, we save its children or itself? 
                // User says "In any node". So just check for selection.
                const hasSelection = this.selected.size > 0 || this.state.focusedNodes.size > 0;
                btnSaveComponent.style.display = hasSelection ? "flex" : "none";

                // If we want to be specific:
                // btnSaveComponent.style.display = (this.selected.size === 1 || isContainer) ? "flex" : "none";
                // But generally "Save Selection as Component" implies any selection.
            }

            // Divider Edit visibility - show if any action button is visible
            const showActionDivider = isTextOrCode || isFolder || isImage || isEmpty || isIcon;
            document.getElementById("divider-edit").style.display = showActionDivider ? "flex" : "none";

            // Color buttons visibility
            const showColors = !isImage && !isFolder && node.type !== "drawing";
            document.getElementById("btn-fill-color").style.display = showColors ? "flex" : "none";
            // Removed btn-text-color from main toolbar as requested
            document.getElementById("btn-text-color").style.display = "none";


            // Colors Divider visibility
            const divColors = document.getElementById("divider-colors");
            if (divColors) divColors.style.display = showColors ? "block" : "none";

            // Enforce mutual exclusivity of toolbars
            const fmtToolbar = document.getElementById('toolbar-formatting');
            const headingsToolbar = document.getElementById('toolbar-headings');
            const colorPresets = document.getElementById('toolbar-color-presets');
            const customColor = document.getElementById('toolbar-custom-color');
            const strokeToolbar = document.getElementById('toolbar-stroke');
            const curveToolbar = document.getElementById('toolbar-curve');
            const nodeSettings = document.getElementById('toolbar-node-settings');
            const containerToolbar = document.getElementById('toolbar-container');

            // Show container toolbar for selected containers
            if (node && node.type === 'container' && !isMultiple) {
                containerToolbar.style.display = 'flex';
                // Update direction icon
                const dirBtn = document.getElementById('btn-container-direction');
                if (dirBtn) {
                    const icon = dirBtn.querySelector('i');
                    if (icon) {
                        icon.setAttribute('data-lucide', node.layout === 'vertical' ? 'arrow-down' : 'arrow-right');
                    }
                }
                // Refresh icons to ensure they render
                setTimeout(() => this.refreshIcons(), 0);
            } else {
                containerToolbar.style.display = 'none';
            }

            const isSubToolbarVisible = (
                fmtToolbar.style.display === 'flex' ||
                headingsToolbar.style.display === 'flex' ||
                colorPresets.style.display === 'flex' ||
                customColor.style.display === 'flex' ||
                strokeToolbar.style.display === 'flex' ||
                curveToolbar.style.display === 'flex' ||
                nodeSettings.style.display === 'flex'
                // NOTE: Don't include containerToolbar here - it shows WITH main toolbar
            );

            if (isSubToolbarVisible) {
                document.getElementById('toolbar-main').style.display = 'none';
                document.getElementById('toolbar-node-settings').style.display = 'none';
                containerToolbar.style.display = 'none'; // Hide container toolbar too
            } else {
                // Only show main if it was supposed to be visible (default state)
                // But we should be careful not to force it if we are in a transition
                // For now, assuming if no sub-toolbar is active, main should be active is safe for this context
                document.getElementById('toolbar-main').style.display = 'flex';
                // Container toolbar visibility already set above based on node type
            }

        } else {
            this.ui.toolbar.style.display = "none";
        }
    },

    setFocusedNode(id) {
        if (this.state.focusedNode) {
            const node = this.nodes.get(this.state.focusedNode);
            if (node) node.element.classList.remove("focused");
        }
        this.state.focusedNode = id;
        if (id) {
            const node = this.nodes.get(id);
            if (node) node.element.classList.add("focused");
        }
        this.updateToolbar();
    },

    // Multi-Focus Management
    addToFocusedNodes(id) {
        this.state.focusedNodes.add(id);
        const node = this.nodes.get(id);
        if (node) {
            node.element.classList.add("focused");
        }
        // Also update single focus for backward compatibility
        this.state.focusedNode = id;
        this.updateToolbar();
    },

    removeFromFocusedNodes(id) {
        this.state.focusedNodes.delete(id);
        const node = this.nodes.get(id);
        if (node) {
            node.element.classList.remove("focused");
        }
        // Update single focus
        if (this.state.focusedNode === id) {
            this.state.focusedNode = this.state.focusedNodes.size > 0 ?
                Array.from(this.state.focusedNodes).pop() : null;
        }

        // AUTO-EXIT FOCUS MODE if no nodes are left
        if (this.state.focusedNodes.size === 0) {
            this.exitFocusMode();
        }

        this.updateToolbar();
    },

    clearFocusedNodes() {
        this.state.focusedNodes.forEach(id => {
            const node = this.nodes.get(id);
            if (node) node.element.classList.remove("focused");
        });
        this.state.focusedNodes.clear();
        this.state.focusedNode = null;
        this.updateToolbar();
    },

    exitFocusMode() {
        this._isFocusMode = false;
        this._focusBrushActive = false;
        document.body.classList.remove('focus-mode-active');
        // Keep focused nodes - they remain focused after exiting mode
    },

    toggleSettings() {
        const menu = document.getElementById("settings-menu");
        menu.style.display = menu.style.display === "flex" ? "none" : "flex";
        // Close other popups
        if (menu.style.display === "flex") {
            document.getElementById("sidebar-extra-popup").style.display = "none";
            document.getElementById("sidebar-more-btn").classList.remove("active");
        }
    },
    toggleSidebarExtra() {
        const popup = document.getElementById('sidebar-extra-popup');
        const btn = document.getElementById('sidebar-more-btn');
        if (!popup) return;

        if (popup.style.display === 'none' || !popup.style.display) {
            popup.style.display = 'flex';
            if (btn) btn.classList.add('active');

            // Check overflow when opening
            this.checkSidebarOverflow();

            // Render Components List
            this.renderComponentsList();
        } else {
            popup.style.display = 'none';
            if (btn) btn.classList.remove('active');
        }
    },

    renderComponentsList() {
        const listContainer = document.getElementById('components-list');
        if (!listContainer) return;

        listContainer.innerHTML = ''; // Clear current

        if (!App.state.components || App.state.components.length === 0) {
            const emptyMsg = document.createElement('div');
            emptyMsg.className = 'empty-message';
            emptyMsg.textContent = 'No components yet';
            emptyMsg.style.color = 'var(--text-secondary)';
            emptyMsg.style.fontSize = '0.8rem';
            emptyMsg.style.padding = '5px';
            emptyMsg.style.textAlign = 'center';
            listContainer.appendChild(emptyMsg);
            return;
        }

        App.state.components.forEach((comp, index) => {
            const btn = document.createElement('div');
            btn.className = 'component-item';
            btn.style.cssText = 'display:flex; align-items:center; gap:8px; padding:8px; border-radius:6px; background:rgba(255,255,255,0.05); cursor:pointer; transition:0.2s;';

            // Icon
            const icon = document.createElement('i');
            icon.setAttribute('data-lucide', comp.icon || 'box');
            icon.style.width = '16px';
            icon.style.height = '16px';
            btn.appendChild(icon);

            // Name
            const name = document.createElement('span');
            name.textContent = comp.name || `Component ${index + 1}`;
            name.style.flex = '1';
            name.style.fontSize = '0.85rem';
            btn.appendChild(name);

            // Delete Action (optional, maybe distinct button)

            btn.onmouseover = () => btn.style.background = 'rgba(255,255,0,0.15)';
            btn.onmouseout = () => btn.style.background = 'rgba(255,255,255,0.05)';

            btn.onclick = () => {
                // Instantiate component
                if (typeof App.instantiateComponent === 'function') {
                    App.instantiateComponent(comp);
                    // Close popup
                    this.toggleSidebarExtra();
                } else {
                    console.warn('App.instantiateComponent not defined');
                }
            };

            listContainer.appendChild(btn);
        });

        // Refresh icons
        if (typeof lucide !== 'undefined') lucide.createIcons();
    },
    toggleLock() {
        const targets = this.state.focusedNodes.size > 0 ? this.state.focusedNodes :
            (this.selected.size > 0 ? this.selected :
                (this.state.focusedNode ? new Set([this.state.focusedNode]) : new Set()));
        targets.forEach(id => {
            const node = this.nodes.get(id);
            if (node) {
                node.locked = !node.locked;
                node.locked ? node.element.classList.add("locked") : node.element.classList.remove("locked");
            }
        });
        this.updateToolbar();
        this.pushHistory();
    },
    openWorkspaceSettings() {
        document.getElementById("workspace-settings").style.display = "flex";
    },
    setBgColor(c) {
        document.body.style.backgroundColor = c;
    },
    setBgImage(input) {
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = e => {
                document.body.style.backgroundImage = `url(${e.target.result})`;
                document.body.style.backgroundSize = "cover";
            };
            reader.readAsDataURL(input.files[0]);
        }
    },
    setGridType(type) {
        const bg = document.getElementById("infinite-bg");
        if (type === "none") {
            bg.style.display = "none";
        } else {
            bg.style.display = "block";
            bg.style.backgroundImage = type === "dots" ? "radial-gradient(var(--grid-dot) 1.5px, transparent 1.5px)" : "linear-gradient(var(--grid-dot) 1px, transparent 1px), linear-gradient(90deg, var(--grid-dot) 1px, transparent 1px)";
        }
    },
    setGridColor(c) {
        document.documentElement.style.setProperty("--grid-dot", c);
    },
    setGridOpacity(val) {
        document.getElementById("infinite-bg").style.opacity = val;
    },
    toggleMagnet() {
        this.state.magnet = !this.state.magnet;
        document.getElementById("magnet-toggle").classList.toggle("active");

        const iconContainer = document.getElementById("magnet-icon").parentElement; // Assuming structure
        // Safer to just update innerHTML of the button/container if id is on the icon
        // Or if id="magnet-icon" is the icon itself (which might be SVG now).
        // Let's Find the button parent.
        const magnetBtn = document.getElementById("magnet-toggle");
        magnetBtn.innerHTML = this.state.magnet ? '<i id="magnet-icon" data-lucide="toggle-right"></i>' : '<i id="magnet-icon" data-lucide="toggle-left"></i>';
        if (typeof lucide !== 'undefined') lucide.createIcons({ root: magnetBtn });
    },
    toggleTheme() {
        this.state.theme = this.state.theme === "dark" ? "light" : "dark";
        document.body.setAttribute("data-theme", this.state.theme);
        document.getElementById("theme-text").innerText = this.state.theme === "dark" ? "داكن" : "فاتح";
    },
    showStrokeSettings() {
        document.getElementById("toolbar-main").style.display = "none";
        document.getElementById("toolbar-stroke").style.display = "flex";
        document.getElementById("toolbar-curve").style.display = "none";
        document.getElementById("toolbar-node-settings").style.display = "none";
        this.ui.colorPanel.style.display = "none";
    },
    showCurveSettings() {
        document.getElementById("toolbar-main").style.display = "none";
        document.getElementById("toolbar-stroke").style.display = "none";
        document.getElementById("toolbar-curve").style.display = "flex";
        document.getElementById("toolbar-node-settings").style.display = "none";
        this.ui.colorPanel.style.display = "none";
    },
    showNodeSettings() {
        document.getElementById("toolbar-main").style.display = "none";
        document.getElementById("toolbar-stroke").style.display = "none";
        document.getElementById("toolbar-curve").style.display = "none";
        document.getElementById("toolbar-node-settings").style.display = "flex";

        // Update Height Toggle Button Visibility
        const btnHeight = document.getElementById("btn-height-toggle");
        const btnGroupLayout = document.getElementById("btn-group-layout");

        if (btnHeight) {
            let hasTextNode = false;
            let isFixed = false;
            let isGroup = false;

            const targets = this.selected.size > 0 ? this.selected :
                (this.state.focusedNodes.size > 0 ? this.state.focusedNodes :
                    (this.state.focusedNode ? new Set([this.state.focusedNode]) : new Set()));
            if (targets.size > 0) {
                const id = Array.from(targets)[0];
                const node = this.nodes.get(id);
                if (node) {
                    if (node.type === "text" || node.type === "text-with-title") {
                        hasTextNode = true;
                        isFixed = !node.autoResize;
                    }
                    if (node.type === "group") {
                        isGroup = true;
                    }
                }
            }

            btnHeight.style.display = hasTextNode ? "flex" : "none";
            if (isFixed) btnHeight.classList.add("active");
            else btnHeight.classList.remove("active");

            if (btnGroupLayout) {
                btnGroupLayout.style.display = isGroup ? "flex" : "none";
            }
        }

        this.ui.colorPanel.style.display = "none";
    },
    showMainToolbar() {
        document.getElementById("toolbar-main").style.display = "flex";
        document.getElementById("toolbar-stroke").style.display = "none";
        document.getElementById("toolbar-curve").style.display = "none";
        document.getElementById("toolbar-node-settings").style.display = "none";
        const layoutSettings = document.getElementById("toolbar-layout-settings");
        if (layoutSettings) layoutSettings.style.display = "none";
    },

    showLayoutSettings() {
        document.getElementById("toolbar-main").style.display = "none";
        const layoutSettings = document.getElementById("toolbar-layout-settings");
        if (layoutSettings) layoutSettings.style.display = "flex";
    },

    showLayoutPropertiesPanel() {
        alert("Layout Properties panel - To be implemented");
    },

    showAlignmentPanel() {
        alert("Alignment panel - To be implemented");
    },

    showPaddingPanel() {
        alert("Padding panel - To be implemented");
    },

    showGapPanel() {
        alert("Gap panel - To be implemented");
    },

    setNodeStrokeOpacity(val) {
        const targets = this.state.focusedNodes.size > 0 ? this.state.focusedNodes :
            (this.selected.size > 0 ? this.selected :
                (this.state.focusedNode ? new Set([this.state.focusedNode]) : new Set()));

        targets.forEach(id => {
            const node = this.nodes.get(id);
            if (node) {
                node.styles.strokeOpacity = val;
                node.updateVisuals();
            }
        });
        this.pushHistory();
    },
    setNodeStrokeWidth(val) {
        const targets = this.state.focusedNodes.size > 0 ? this.state.focusedNodes :
            (this.selected.size > 0 ? this.selected :
                (this.state.focusedNode ? new Set([this.state.focusedNode]) : new Set()));
        targets.forEach(id => {
            const node = this.nodes.get(id);
            if (node) {
                node.styles.strokeWidth = val;
                node.updateVisuals();
            }
        });
        this.pushHistory();
    },
    setNodeRadius(val) {
        const targets = this.state.focusedNodes.size > 0 ? this.state.focusedNodes :
            (this.selected.size > 0 ? this.selected :
                (this.state.focusedNode ? new Set([this.state.focusedNode]) : new Set()));
        targets.forEach(id => {
            const node = this.nodes.get(id);
            if (node) {
                node.styles.radius = val;
                node.updateVisuals();
            }
        });
    },
    setInteracting(isInteracting) {
        if (isInteracting) document.body.classList.add("interacting");
        else document.body.classList.remove("interacting");
    },
    toggleEditing() {
        const targets = this.state.focusedNodes.size > 0 ? this.state.focusedNodes :
            (this.selected.size > 0 ? this.selected : new Set()); // Editing usually single, but if multi focus?
        // Prioritize selection for editing unless specific request logic.
        // Actually, editing multiple nodes is tricky. Let's keep it simplest for now or match others.
        // User asked for "shared commands". Editing is specific.
        // Let's NOT change toggleEditing priority blindly unless needed.
        // BUT, if we are in focus mode, we might want to edit?
        // If multiple focused, we HIDE the edit button. So this function is unlikely called for multi.
        // So I will SKIP updating toggleEditing to avoid aggression.
        if (targets.size > 0) {
            const id = Array.from(targets)[0];
            const node = this.nodes.get(id);
            if (node && (node.type === "text" || node.type === "code" || node.type === "text-with-title")) {
                const editor = node.element.querySelector(".text-content-editor, .code-content");
                const isEditing = node.element.classList.contains("editing");

                if (isEditing) {
                    // Disable editing
                    if (editor) {
                        if (editor.tagName === "TEXTAREA") {
                            editor.setAttribute("readonly", "true");
                        } else {
                            editor.setAttribute("contenteditable", "false");
                        }
                        editor.blur();
                    }
                    node.element.classList.remove("editing");
                    // Hide inline formatting toolbar and show main
                    this.hideFormattingToolbar();
                    document.getElementById('btn-edit').classList.remove('active');
                } else {
                    // Enable editing AND show inline formatting toolbar
                    node.element.classList.add("editing");
                    this.showInlineFormattingToolbar(id);

                    if (editor) {
                        if (editor.tagName === "TEXTAREA") {
                            editor.removeAttribute("readonly");
                        } else {
                            editor.setAttribute("contenteditable", "true");
                        }
                        editor.focus();
                    }
                    document.getElementById('btn-edit').classList.add('active');
                }
            }
        }
    },
    toggleHeightMode() {
        const targets = this.state.focusedNodes.size > 0 ? this.state.focusedNodes :
            (this.selected.size > 0 ? this.selected :
                (this.state.focusedNode ? new Set([this.state.focusedNode]) : new Set()));
        if (targets.size > 0) {
            const btn = document.getElementById('btn-height-toggle');
            targets.forEach(id => {
                const node = this.nodes.get(id);
                if (node && (node.type === "text" || node.type === "text-with-title")) {
                    node.setAutoResize(!node.autoResize);
                    // Update visual indicator
                    if (!node.autoResize) {
                        btn.classList.add('active'); // Fixed Height (Manual)
                    } else {
                        btn.classList.remove('active'); // Auto Height
                    }
                }
            });
            this.pushHistory();
        }
    },
    // ==== NEW Color Picker System ====
    showColorPicker(type) {
        this.currentColorType = type;

        // Hide all toolbars
        document.getElementById('toolbar-main').style.display = 'none';
        document.getElementById('toolbar-stroke').style.display = 'none';
        document.getElementById('toolbar-curve').style.display = 'none';
        document.getElementById('toolbar-node-settings').style.display = 'none';
        document.getElementById('toolbar-formatting').style.display = 'none';
        document.getElementById('toolbar-headings').style.display = 'none';

        // Show color presets toolbar
        document.getElementById('toolbar-color-presets').style.display = 'flex';
    },

    applyPresetColor(color) {
        this.applyColorByType(color, this.currentColorType);
        this.hideColorPicker();
    },

    showCustomColorPicker() {
        document.getElementById('toolbar-color-presets').style.display = 'none';
        document.getElementById('toolbar-custom-color').style.display = 'flex';

        // Initialize with Hue mode active
        this._currentHSBMode = 'hue';
        this.initHSBSliders();
    },

    initHSBSliders() {
        // Get current color from selected/focused node
        let currentColor = '#ffffff';
        const targets = this.selected.size > 0 ? this.selected : (this.state.focusedNode ? new Set([this.state.focusedNode]) : new Set());
        if (targets.size > 0) {
            const node = this.nodes.get(Array.from(targets)[0]);
            if (node) {
                if (this.currentColorType === 'fill') currentColor = node.styles.fill;
                else if (this.currentColorType === 'text') currentColor = node.styles.text;
                else if (this.currentColorType === 'stroke') currentColor = node.styles.stroke || '#ffffff';
            }
        }

        // Convert to HSB and store values
        const hsb = this.hexToHSB(currentColor);
        this._hsbValues = {
            h: hsb.h,
            s: hsb.s,
            b: hsb.b
        };

        // Set slider based on current mode (default hue)
        this.setHSBMode(this._currentHSBMode || 'hue');
    },

    setHSBMode(mode) {
        // Update active button
        document.querySelectorAll('.hsb-toggle-btn').forEach(btn => {
            btn.classList.toggle('active', btn.dataset.mode === mode);
        });

        this._currentHSBMode = mode;
        const slider = document.getElementById('hsb-slider');

        // Configure slider based on mode
        if (mode === 'hue') {
            slider.min = 0;
            slider.max = 360;
            slider.value = this._hsbValues.h;
            // Update slider background for hue
            slider.style.background = 'linear-gradient(to right, #ff0000 0%, #ffff00 17%, #00ff00 33%, #00ffff 50%, #0000ff 67%, #ff00ff 83%, #ff0000 100%)';
        } else if (mode === 'saturation') {
            slider.min = 0;
            slider.max = 100;
            slider.value = this._hsbValues.s;
            // Gray to current hue color
            const hueColor = this.hsbToHex(this._hsbValues.h, 100, 100);
            slider.style.background = `linear-gradient(to right, #888 0%, ${hueColor} 100%)`;
        } else { // brightness
            slider.min = 0;
            slider.max = 100;
            slider.value = this._hsbValues.b;
            // Black to current hue+saturation color
            const fullColor = this.hsbToHex(this._hsbValues.h, this._hsbValues.s, 100);
            slider.style.background = `linear-gradient(to right, #000 0%, ${fullColor} 100%)`;
        }

        this.updateCustomColorPreview();
    },

    updateCustomColorPreview() {
        // Update the stored value based on current mode
        const sliderValue = parseInt(document.getElementById('hsb-slider').value);

        if (this._currentHSBMode === 'hue') {
            this._hsbValues.h = sliderValue;
        } else if (this._currentHSBMode === 'saturation') {
            this._hsbValues.s = sliderValue;
        } else { // brightness
            this._hsbValues.b = sliderValue;
        }

        // Generate color and update preview
        const color = this.hsbToHex(this._hsbValues.h, this._hsbValues.s, this._hsbValues.b);
        document.getElementById('custom-color-preview').style.background = color;

        // Update slider gradient for saturation/brightness modes
        if (this._currentHSBMode === 'saturation') {
            const hueColor = this.hsbToHex(this._hsbValues.h, 100, 100);
            document.getElementById('hsb-slider').style.background = `linear-gradient(to right, #888 0%, ${hueColor} 100%)`;
        } else if (this._currentHSBMode === 'brightness') {
            const fullColor = this.hsbToHex(this._hsbValues.h, this._hsbValues.s, 100);
            document.getElementById('hsb-slider').style.background = `linear-gradient(to right, #000 0%, ${fullColor} 100%)`;
        }
    },

    hsbToHex(h, s, b) {
        s /= 100;
        b /= 100;

        const k = (n) => (n + h / 60) % 6;
        const f = (n) => b * (1 - s * Math.max(0, Math.min(k(n), 4 - k(n), 1)));

        const r = Math.round(255 * f(5));
        const g = Math.round(255 * f(3));
        const b2 = Math.round(255 * f(1));

        return '#' + [r, g, b2].map(x => x.toString(16).padStart(2, '0')).join('');
    },

    hexToHSB(hex) {
        // Convert hex to RGB
        if (!hex || !hex.startsWith('#')) return { h: 0, s: 100, b: 100 };

        const r = parseInt(hex.slice(1, 3), 16) / 255;
        const g = parseInt(hex.slice(3, 5), 16) / 255;
        const b = parseInt(hex.slice(5, 7), 16) / 255;

        const max = Math.max(r, g, b);
        const min = Math.min(r, g, b);
        const delta = max - min;

        let h = 0;
        if (delta !== 0) {
            if (max === r) h = 60 * (((g - b) / delta) % 6);
            else if (max === g) h = 60 * ((b - r) / delta + 2);
            else h = 60 * ((r - g) / delta + 4);
        }
        if (h < 0) h += 360;

        const s = max === 0 ? 0 : (delta / max) * 100;
        const brightness = max * 100;

        return { h: Math.round(h), s: Math.round(s), b: Math.round(brightness) };
    },

    confirmCustomColor() {
        const color = document.getElementById('custom-color-preview').style.background;
        // Convert rgb() to hex if needed
        const hexColor = color.startsWith('#') ? color : this.rgbToHex(color);
        this.applyColorByType(hexColor, this.currentColorType);
        this.hideColorPicker();
    },

    rgbToHex(rgb) {
        const values = rgb.match(/\d+/g);
        if (!values || values.length < 3) return '#ffffff';
        return '#' + values.slice(0, 3).map(x => parseInt(x).toString(16).padStart(2, '0')).join('');
    },

    backToColorPresets() {
        document.getElementById('toolbar-custom-color').style.display = 'none';
        document.getElementById('toolbar-color-presets').style.display = 'flex';
    },

    hideColorPicker() {
        document.getElementById('toolbar-color-presets').style.display = 'none';
        document.getElementById('toolbar-custom-color').style.display = 'none';
        document.getElementById('toolbar-main').style.display = 'flex';
    },

    applyColorByType(color, type) {
        const targets = this.state.focusedNodes.size > 0 ? this.state.focusedNodes :
            (this.selected.size > 0 ? this.selected :
                (this.state.focusedNode ? new Set([this.state.focusedNode]) : new Set()));
        targets.forEach(id => {
            const node = this.nodes.get(id);
            if (node) {
                if (type === 'fill') node.styles.fill = color;
                else if (type === 'text') node.styles.text = color;
                else if (type === 'stroke') node.styles.stroke = color;
                node.updateVisuals();
            }
        });
        this.pushHistory();
    },

    // ==== OLD Color System (Keep for compatibility) ====
    showColors(mode) {
        // Redirect to new system
        this.showColorPicker(mode);
    },
    applyColor(color) {
        this.applyColorByType(color, this.currentColorType || this._colorMode);
        this.hideColorPicker();
    },


    // ==== Formatting Toolbar Functions ====

    // ==== NEW Inline Formatting Toolbar ====
    showInlineFormattingToolbar(nodeId, autoFocus = true) {
        this._activeEditorNode = nodeId;
        const node = this.nodes.get(nodeId);
        if (!node) return;

        node.element.classList.add("editing");

        // ENABLE EDITING MODE - Make editor editable and focused
        const editor = node.element.querySelector(".text-content-editor, .code-content");
        if (editor) {
            if (editor.tagName === "TEXTAREA") {
                editor.removeAttribute("readonly");
            } else {
                editor.setAttribute("contenteditable", "true");
            }

            if (autoFocus) {
                // Focus editor after a small delay to ensure it's ready
                setTimeout(() => editor.focus(), 50);
            }
        }

        // Hide ALL toolbars first
        document.getElementById('toolbar-main').style.display = 'none';
        document.getElementById('toolbar-stroke').style.display = 'none';
        document.getElementById('toolbar-curve').style.display = 'none';
        document.getElementById('toolbar-node-settings').style.display = 'none';
        document.getElementById('toolbar-color-presets').style.display = 'none';
        document.getElementById('toolbar-custom-color').style.display = 'none';
        document.getElementById('toolbar-headings').style.display = 'none';

        // Show formatting toolbar
        document.getElementById('toolbar-formatting').style.display = 'flex';
    },


    hideFormattingToolbar() {
        // Disable editing for the active node
        if (this._activeEditorNode) {
            const node = this.nodes.get(this._activeEditorNode);
            if (node) {
                node.element.classList.remove("editing");
                const editor = node.element.querySelector(".text-content-editor, .code-content");
                if (editor) {
                    if (editor.tagName === "TEXTAREA") {
                        editor.setAttribute("readonly", "true");
                    } else {
                        editor.setAttribute("contenteditable", "false");
                    }
                }
            }
        }

        // Return to main toolbar
        document.getElementById('toolbar-formatting').style.display = 'none';
        document.getElementById('toolbar-headings').style.display = 'none';
        document.getElementById('toolbar-main').style.display = 'flex';
        document.getElementById('btn-edit').classList.remove('active');
        this.updateToolbar();
    },

    // ==== Heading Selector Functions ====
    showHeadingSelector() {
        document.getElementById('toolbar-formatting').style.display = 'none';
        document.getElementById('toolbar-headings').style.display = 'flex';
    },

    backToFormatting() {
        document.getElementById('toolbar-headings').style.display = 'none';
        document.getElementById('toolbar-formatting').style.display = 'flex';
    },

    applyHeadingAndReturn(level) {
        this.applyHeading(level);
        // Update button text
        document.getElementById('heading-selector-btn').textContent = `H${level}`;
        // Return to formatting toolbar but keep editing active
        this.backToFormatting();
        // Refocus editor
        if (this._activeEditorNode) {
            const node = this.nodes.get(this._activeEditorNode);
            if (node) {
                const editor = node.element.querySelector(".text-content-editor, .code-content");
                if (editor) editor.focus();
            }
        }
    },


    showFormattingToolbar(nodeId) {
        this._activeEditorNode = nodeId;
        const node = this.nodes.get(nodeId);
        if (!node) return;

        // Ensure "editing" class is set
        node.element.classList.add("editing");

        // Hide Main Toolbar
        this.ui.toolbar.style.display = "none";

        const toolbar = document.getElementById('formatting-toolbar');
        toolbar.classList.add('visible');
        toolbar.style.display = "flex";

        // Position toolbar above the node
        const rect = node.element.getBoundingClientRect();
        const tbRect = toolbar.getBoundingClientRect();

        let left = rect.left + rect.width / 2;
        let top = rect.top - 50; // Above node

        // Boundary check
        if (left - tbRect.width / 2 < 10) left = tbRect.width / 2 + 10;
        if (left + tbRect.width / 2 > window.innerWidth - 10) left = window.innerWidth - tbRect.width / 2 - 10;
        if (top < 10) top = rect.bottom + 10; // Flip if too high

        toolbar.style.left = `${left}px`;
        toolbar.style.top = `${top}px`;
        toolbar.style.transform = 'translateX(-50%)';
    },

    handleEditorBlur(nodeId) {
        // Delay to allow check for related target (toolbar clicks)
        setTimeout(() => {
            const activeElement = document.activeElement;
            const toolbar = document.getElementById('formatting-toolbar');
            const colorPicker = document.getElementById('text-color-picker');

            // Check if focus moved to any part of the formatting UI
            if (toolbar && toolbar.contains(activeElement)) return;
            if (colorPicker && colorPicker.contains(activeElement)) return;

            // Also check if mouse is actively interacting with these elements
            // (fixes issue where clicking non-focusable buttons triggers blur)
            if (toolbar && toolbar.matches(':hover')) return;
            if (colorPicker && colorPicker.matches(':hover')) return;

            // If we are here, we truly lost focus
            const node = this.nodes.get(nodeId);
            if (node) {
                // Check if focus is still inside the node (e.g. switched between Title and Body)
                if (node.element.contains(activeElement)) return;

                // Remove editing state
                node.element.classList.remove("editing");

                const editor = node.element.querySelector(".text-content-editor, .code-content");
                if (editor) {
                    if (editor.tagName === "TEXTAREA") {
                        editor.setAttribute("readonly", "true");
                    } else {
                        // Trim empty lines for auto-height
                        App.trimEditorContent(editor);
                        // Force update height
                        App.handleInput(editor);
                        editor.setAttribute("contenteditable", "false");
                    }
                }

                if (toolbar) {
                    toolbar.classList.remove('visible');
                    toolbar.style.display = 'none';
                }
                if (colorPicker) colorPicker.classList.remove('visible');

                // Show Main Toolbar again if selection persists
                this.updateToolbar();
            }
        }, 150);
    },

    applyFormat(format, value = null) {
        const node = this.nodes.get(this._activeEditorNode);
        if (!node) return;

        const editor = node.element.querySelector(".text-content-editor");
        if (!editor) return;

        // Ensure Editor Focus
        if (document.activeElement !== editor) editor.focus();

        // 1. Handle Implicit Selection (Word selection if collapsed)
        const selection = window.getSelection();
        if (selection.rangeCount > 0 && selection.isCollapsed) {
            // Only for inline formats (Bold, Italic, etc.) not blocks
            // Blocks usually handle themselves (align paragraph)
            const inlineFormats = ['bold', 'italic', 'underline', 'strikeThrough', 'foreColor', 'fontName', 'fontSize'];
            if (inlineFormats.includes(format) || format === 'foreColor') {
                // Select Line logic
                if (selection.modify) {
                    // Move to start of line
                    selection.modify("move", "backward", "lineboundary");
                    // Extend to end of line
                    selection.modify("extend", "forward", "lineboundary");
                }
            }
        }

        // 2. Execute Command
        document.execCommand(format, false, value);

        // 3. Ensure Focus is kept on Editor
        editor.focus();
    },

    applyHeading(level) {
        // Focus first
        const node = this.nodes.get(this._activeEditorNode);
        if (node) {
            const editor = node.element.querySelector(".text-content-editor");
            if (editor) editor.focus();
        }
        document.execCommand('formatBlock', false, `<H${level}>`);
    },

    toggleTextColorPicker() {
        const picker = document.getElementById('text-color-picker');
        const btn = document.getElementById('color-format-btn'); // The A icon in formatting toolbar

        if (!picker || !btn) return;

        const rect = btn.getBoundingClientRect();

        if (picker.classList.contains('visible')) {
            picker.classList.remove('visible');
        } else {
            picker.classList.add('visible');
            picker.style.left = `${rect.left}px`;
            picker.style.top = `${rect.bottom + 8}px`;
        }
    },

    applyTextColor(color) {
        const node = this.nodes.get(this._activeEditorNode);
        if (!node) return;
        const editor = node.element.querySelector(".text-content-editor");

        // 1. Focus Editor
        if (editor) editor.focus();

        // 2. Handle Implicit Selection (Current Line)
        const selection = window.getSelection();
        if (selection.rangeCount > 0 && selection.isCollapsed) {
            if (selection.modify) {
                selection.modify("move", "backward", "lineboundary");
                selection.modify("extend", "forward", "lineboundary");
            }
        }

        // 3. Apply Color
        if (color === 'inherit') {
            document.execCommand('removeFormat', false, 'foreColor');
        } else {
            document.execCommand('foreColor', false, color);
        }

        // 4. Update Indicator
        const indicator = document.getElementById('text-color-indicator');
        if (indicator) indicator.style.background = color;

        // 5. Hide Picker but KEEP Formatting Toolbar
        const picker = document.getElementById('text-color-picker');
        if (picker) picker.classList.remove('visible');

        // Ensure formatting active with correct inline mode
        this.showInlineFormattingToolbar(this._activeEditorNode);

        // Refocus one last time
        if (editor) editor.focus();
    },

    toggleFontSizePicker() {
        // Simple implementation for now - cycle sizes
        // document.execCommand('fontSize', false, '3');
    },

    renameFolder() {
        if (this.selected.size !== 1) return;
        const id = Array.from(this.selected)[0];
        const node = this.nodes.get(id);
        if (node.type !== "folder") return;

        const titleEl = node.element.querySelector(".folder-title");
        if (titleEl) {
            titleEl.style.pointerEvents = "auto";
            titleEl.setAttribute("contenteditable", "true");
            titleEl.focus();
            // Select all text
            const range = document.createRange();
            range.selectNodeContents(titleEl);
            const sel = window.getSelection();
            sel.removeAllRanges();
            sel.addRange(range);
        }
    },

    onFolderTitleBlur(el, id) {
        el.setAttribute("contenteditable", "false");
        el.style.pointerEvents = "none";
        const node = this.nodes.get(id);
        if (node) {
            node.title = el.innerText;
            this.saveCurrentWorkspace();
        }
    },

    triggerUpload(id) {
        this._pendingUpload = id;
        document.getElementById("file-input").click();
    },
    openViewer(src) {
        // Find the node that contains this image
        let nodeId = null;
        let imageIndex = 0;

        for (const [id, node] of this.nodes) {
            if (node.type === 'image' && node.images) {
                const index = node.images.indexOf(src);
                if (index !== -1) {
                    nodeId = id;
                    imageIndex = index;
                    break;
                }
            }
        }

        if (nodeId && window.ImageViewer) {
            window.ImageViewer.open(nodeId, imageIndex);
        } else {
            // Fallback - log warning for debugging
            console.warn('ImageViewer not ready or node not found. NodeId:', nodeId, 'ImageViewer:', !!window.ImageViewer);
            const viewerImg = document.getElementById("viewer-img");
            const viewer = document.getElementById("image-viewer");
            if (viewerImg && viewer) {
                viewerImg.src = src;
                viewer.style.display = "flex";
            }
        }
    },

    // ==== Edit Capsule Logic ====
    showEditCapsule(x, y) {
        const capsule = document.getElementById('edit-capsule');
        if (!capsule) return;

        capsule.style.display = 'flex';

        // Position centering logic
        const rect = capsule.getBoundingClientRect();
        // Adjust to center horizontally on the click
        let left = x - rect.width / 2;
        let top = y - rect.height - 10; // Position above cursor

        // Boundary checks
        if (left < 10) left = 10;
        if (left + rect.width > window.innerWidth - 10) left = window.innerWidth - rect.width - 10;
        if (top < 10) top = y + 20; // Flip to below if too close to top

        capsule.style.left = `${left}px`;
        capsule.style.top = `${top}px`;

        // Auto-hide context menu on next click elsewhere
        const hideHandler = (e) => {
            if (!capsule.contains(e.target)) {
                this.hideEditCapsule();
                window.removeEventListener('pointerdown', hideHandler);
            }
        };
        // Delay adding listener to avoid immediate trigger
        setTimeout(() => window.addEventListener('pointerdown', hideHandler), 100);
    },

    hideEditCapsule() {
        const capsule = document.getElementById('edit-capsule');
        if (capsule) capsule.style.display = 'none';
    },

    toggleGroupEditMode() {
        const targets = this.state.focusedNodes.size > 0 ? this.state.focusedNodes :
            (this.selected.size > 0 ? this.selected :
                (this.state.focusedNode ? new Set([this.state.focusedNode]) : new Set()));
        if (targets.size > 0) {
            const btn = document.getElementById('btn-group-edit');
            targets.forEach(id => {
                const node = this.nodes.get(id);
                if (node && node.type === 'group') {
                    // Toggle editing state
                    if (node.element.classList.contains('group-editing')) {
                        node.element.classList.remove('group-editing');
                        node.isEditing = false;
                        if (btn) btn.classList.remove('active');
                    } else {
                        node.element.classList.add('group-editing');
                        node.isEditing = true;
                        if (btn) btn.classList.add('active');
                    }
                }
            });
            this.updateToolbar();
        }
    },
    handleCapsuleAction(action) {
        this.hideEditCapsule();

        // Focus the active editor if known, or document.activeElement
        let activeEl = document.activeElement;

        // Try to recover focus if lost
        if (!activeEl || (!activeEl.isContentEditable && activeEl.tagName !== 'INPUT' && activeEl.tagName !== 'TEXTAREA')) {
            if (this._activeEditorNode) {
                const node = this.nodes.get(this._activeEditorNode);
                if (node) {
                    const editor = node.element.querySelector(".text-content-editor, .code-content");
                    if (editor) {
                        editor.focus();
                        activeEl = editor;
                    }
                }
            }
        }

        switch (action) {
            case 'copy':
                document.execCommand('copy');
                break;
            case 'cut':
                document.execCommand('cut');
                break;
            case 'paste':
                // Use Clipboard API
                if (navigator.clipboard && navigator.clipboard.readText) {
                    navigator.clipboard.readText().then(text => {
                        if (activeEl) {
                            activeEl.focus(); // Ensure focus is fresh
                            if (activeEl.tagName === 'INPUT' || activeEl.tagName === 'TEXTAREA') {
                                // Modern replacement for inputs
                                if (activeEl.setRangeText) {
                                    activeEl.setRangeText(text, activeEl.selectionStart, activeEl.selectionEnd, 'end');
                                    // Trigger input event manually for listeners
                                    activeEl.dispatchEvent(new Event('input', { bubbles: true }));
                                } else {
                                    document.execCommand('insertText', false, text);
                                }
                            } else {
                                // ContentEditable
                                document.execCommand('insertText', false, text);
                            }
                        }
                    }).catch(err => {
                        console.error('Clipboard Access Failed:', err);
                        // Fallback
                        document.execCommand('paste');
                    });
                } else {
                    document.execCommand('paste');
                }
                break;
            case 'delete':
                document.execCommand('delete');
                break;
        }
    },

    setContainerLayout(mode) {
        const targets = this.state.focusedNodes.size > 0 ? this.state.focusedNodes :
            (this.selected.size > 0 ? this.selected :
                (this.state.focusedNode ? new Set([this.state.focusedNode]) : new Set()));

        targets.forEach(id => {
            const node = this.nodes.get(id);
            if (node && node.type === 'container') {
                node.updateLayout(mode);
            }
        });
        this.pushHistory();
    },

    setContainerJustifyContent(value) {
        const targets = this.state.focusedNodes.size > 0 ? this.state.focusedNodes :
            (this.selected.size > 0 ? this.selected :
                (this.state.focusedNode ? new Set([this.state.focusedNode]) : new Set()));

        targets.forEach(id => {
            const node = this.nodes.get(id);
            if (node && node.type === 'container') {
                node.justifyContent = value;
                node.updateVisuals();
            }
        });
        this.pushHistory();
    },

    setContainerPadding(value) {
        // Debounce updates to avoid excessive reflows
        clearTimeout(this._paddingDebounce);
        this._paddingDebounce = setTimeout(() => {
            const targets = this.state.focusedNodes.size > 0 ? this.state.focusedNodes :
                (this.selected.size > 0 ? this.selected :
                    (this.state.focusedNode ? new Set([this.state.focusedNode]) : new Set()));

            targets.forEach(id => {
                const node = this.nodes.get(id);
                if (node && node.type === 'container') {
                    node.padding = parseInt(value) || 0;
                    node.updateVisuals();
                }
            });
            this.pushHistory();
        }, 150);
    },

    setContainerGap(value) {
        // Debounce updates to avoid excessive reflows
        clearTimeout(this._gapDebounce);
        this._gapDebounce = setTimeout(() => {
            const targets = this.state.focusedNodes.size > 0 ? this.state.focusedNodes :
                (this.selected.size > 0 ? this.selected :
                    (this.state.focusedNode ? new Set([this.state.focusedNode]) : new Set()));

            targets.forEach(id => {
                const node = this.nodes.get(id);
                if (node && node.type === 'container') {
                    node.gap = parseInt(value) || 0;
                    node.updateVisuals();
                }
            });
            this.pushHistory();
        }, 150);
    },

    updateChildPanelValues(node) {
        if (!node) return;

        // Update width buttons
        document.querySelectorAll('.child-width-btn').forEach(btn => {
            btn.classList.toggle('active', btn.dataset.mode === node.flexModeWidth);
        });

        // Update height buttons
        document.querySelectorAll('.child-height-btn').forEach(btn => {
            btn.classList.toggle('active', btn.dataset.mode === node.flexModeHeight);
        });
    },

    setChildFlexModeWidth(mode) {
        const targets = this.state.focusedNodes.size > 0 ? this.state.focusedNodes :
            (this.selected.size > 0 ? this.selected :
                (this.state.focusedNode ? new Set([this.state.focusedNode]) : new Set()));

        targets.forEach(id => {
            const node = this.nodes.get(id);
            if (node && node.parent && node.parent.type === 'container') {
                node.flexModeWidth = mode;
                node.updateVisuals();
            }
        });

        if (targets.size === 1) {
            const node = this.nodes.get(Array.from(targets)[0]);
            if (node) this.updateChildPanelValues(node);
        }

        this.pushHistory();
    },

    setChildFlexModeHeight(mode) {
        const targets = this.state.focusedNodes.size > 0 ? this.state.focusedNodes :
            (this.selected.size > 0 ? this.selected :
                (this.state.focusedNode ? new Set([this.state.focusedNode]) : new Set()));

        targets.forEach(id => {
            const node = this.nodes.get(id);
            if (node && node.parent && node.parent.type === 'container') {
                node.flexModeHeight = mode;
                node.updateVisuals();
            }
        });

        if (targets.size === 1) {
            const node = this.nodes.get(Array.from(targets)[0]);
            if (node) this.updateChildPanelValues(node);
        }

        this.pushHistory();
    },

    setContainerFlexModeWidth(mode) {
        const targets = this.state.focusedNodes.size > 0 ? this.state.focusedNodes : this.selected;

        targets.forEach(id => {
            const node = this.nodes.get(id);
            if (node && node.type === 'container' && node.parent && node.parent.type === 'container') {
                node.flexModeWidth = mode;
                node.updateVisuals();
            }
        });

        if (targets.size === 1) {
            const node = this.nodes.get(Array.from(targets)[0]);
            if (node) this.updatePropertiesPanelValues(node);
        }

        this.pushHistory();
    },

    setContainerFlexModeHeight(mode) {
        const targets = this.state.focusedNodes.size > 0 ? this.state.focusedNodes : this.selected;

        targets.forEach(id => {
            const node = this.nodes.get(id);
            if (node && node.type === 'container' && node.parent && node.parent.type === 'container') {
                node.flexModeHeight = mode;
                node.updateVisuals();
            }
        });

        if (targets.size === 1) {
            const node = this.nodes.get(Array.from(targets)[0]);
            if (node) this.updatePropertiesPanelValues(node);
        }

        this.pushHistory();
    },
    // ==== Display Mode Toggle ====
    setDisplayMode(mode) {
        // mode: 'normal' | 'app' | 'immersive'
        const root = document.documentElement;

        if (mode === 'normal') {
            if (document.fullscreenElement) {
                document.exitFullscreen().catch(err => console.error(err));
            }
            document.body.classList.remove('immersive-mode');
        } else if (mode === 'app') {
            if (!document.fullscreenElement) {
                root.requestFullscreen().catch(err => console.error(err));
            }
            document.body.classList.remove('immersive-mode');
        } else if (mode === 'immersive') {
            if (!document.fullscreenElement) {
                root.requestFullscreen().catch(err => console.error(err));
            }
            document.body.classList.add('immersive-mode');
        }

        App.state.displayMode = mode;
        this.updateDisplayModeUI();
    },

    updateDisplayModeUI() {
        const mode = App.state.displayMode;
        // Update active state of buttons if they exist
        const btns = document.querySelectorAll('.display-mode-btn');
        btns.forEach(btn => {
            if (btn.dataset.mode === mode) btn.classList.add('active');
            else btn.classList.remove('active');
        });
    },

    initDisplayModeListeners() {
        document.addEventListener('fullscreenchange', () => {
            if (!document.fullscreenElement) {
                // User exited fullscreen (e.g. via ESC)
                // Force back to normal mode
                App.state.displayMode = 'normal';
                document.body.classList.remove('immersive-mode');
                this.updateDisplayModeUI();
            }
        });
    },

    // ==== Sidebar Overflow Logic ====
    checkSidebarOverflow() {
        const sidebar = document.getElementById('sidebar');
        const toolsContainer = document.getElementById('sidebar-tools');
        const overflowContainer = document.getElementById('overflow-tools');

        if (!sidebar || !toolsContainer || !overflowContainer) return;

        // Reset state to calculate full height
        // Move all items back to Sidebar for measurement
        // We need to preserve order, so we append overflow items back to the END of toolsContainer
        // CAREFUL: If we have mixed content (buttons, dividers), simple append might break structure if not careful.
        // Current structure: toolsContainer contains buttons + one divider.
        // Strategy: We only move BUTTONS. Dividers might need handling.
        // Actually, let's keep it simple: Move last child of toolsContainer to Overflow.

        // REVERSE strategy: First move EVERYTHING back to check if it fits.
        const overflowItems = Array.from(overflowContainer.children);
        // They are stored in reverse order of removal (FILO)? No, we prepend or append?
        // Let's stick to: Remove from END of Sidebar -> Add to START of Overflow.
        // So to restore: Take from START of Overflow -> Add to END of Sidebar.
        overflowItems.forEach(child => {
            toolsContainer.appendChild(child);
        });

        overflowContainer.style.display = 'none';

        // Available Height: Window height - margins (e.g., 40px total)
        const availableHeight = window.innerHeight - 40;

        // Loop while sidebar height > available height
        // We use scrollHeight to detect internal overflow if we didn't use fixed positioning? 
        // Sidebar is fixed/absolute. 
        // We compare sidebar.offsetHeight with availableHeight.

        while (sidebar.scrollHeight > availableHeight && toolsContainer.children.length > 0) {
            const lastTool = toolsContainer.lastElementChild;
            if (!lastTool) break;

            // Move to overflow (Prepend to keep order: Bottom items go to top of list? Or just append?)
            // If we remove A, B, C from bottom. 
            // C removed first -> Overflow: [C]
            // B removed next -> Overflow: [B, C] (if prepend) or [C, B] (if append)
            // Visually in "More" menu, maybe we want them in order?
            // "More" menu usually lists "hidden" items.
            // Let's Prepend to Overflow so the "bottom-most" item becomes the first in the list? 
            // No, usually top item in sidebar is "Primary". Bottom is "Secondary".
            // If we hide bottom items, they are less important.
            // Let's just append to overflow for now.
            if (overflowContainer.firstChild) {
                overflowContainer.insertBefore(lastTool, overflowContainer.firstChild);
            } else {
                overflowContainer.appendChild(lastTool);
            }
        }

        // Show overflow container if it has items
        if (overflowContainer.children.length > 0) {
            overflowContainer.style.display = 'flex';
        }
    },

    initSidebarOverflowListener() {
        window.addEventListener('resize', () => {
            clearTimeout(this._resizeTimer);
            this._resizeTimer = setTimeout(() => this.checkSidebarOverflow(), 100);
        });
        setTimeout(() => this.checkSidebarOverflow(), 500);
    },
});
